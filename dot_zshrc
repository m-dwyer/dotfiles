# Deliberately NOT exported: zim and HISTFILE resolve it within this shell, but
# exporting it makes every child zsh read ~/.config/zsh/.zshrc instead of this
# file — i.e. `exec zsh` would drop mise, starship and every alias.
ZDOTDIR=~/.config/zsh
export ZIM_HOME=~/.zim

# Install missing modules, and update ${ZIM_HOME}/init.zsh if missing or outdated.
if [[ ! ${ZIM_HOME}/init.zsh -nt ${ZDOTDIR:-${HOME}}/.zimrc ]]; then
  source ${ZIM_HOME}/zimfw.zsh init -q
fi

autoload -U compinit; compinit
source ${ZIM_HOME}/init.zsh

