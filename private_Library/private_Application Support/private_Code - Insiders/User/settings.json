{
  "window.zoomLevel": 1,
  "security.promptForLocalFileProtocolHandling": false,
  "editor.fontFamily": "Menlo, Monaco, 'Courier New', 'SF Pro', monospace",
  // we try to make semantic highlighting look good
  "editor.semanticHighlighting.enabled": true,
  // prevent VSCode from modifying the terminal colors
  "terminal.integrated.minimumContrastRatio": 1,
  // make the window's titlebar use the workbench colors
  "window.titleBarStyle": "custom",
  // applicable if you use Go, this is an opt-in flag!
  "gopls": {
    "ui.semanticTokens": true,
  },
  // pink as the accent color
  "catppuccin.accentColor": "pink",
  // make Mocha specifically very dark
  // (this preserves other flavors!)
  "catppuccin.colorOverrides": {
    "mocha": {
      "base": "#000000",
      "mantle": "#010101",
      "crust": "#020202",
    },
  },
  // use your accent (pink) on the statusBar as well
  "catppuccin.customUIColors": {
    "mocha": {
      "statusBar.foreground": "accent",
    },
  },
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "[dart]": {
    "editor.defaultFormatter": "Dart-Code.dart-code",
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [
      80
    ],
    "editor.selectionHighlight": false,
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll": "explicit",
    }
  },
  "python.defaultInterpreterPath": "/opt/homebrew/Caskroom/miniconda/base/envs/embed",
  "terminal.integrated.inheritEnv": false,
  "git.openRepositoryInParentFolders": "never",
  "dart.debugExternalPackageLibraries": true,
  "dart.debugSdkLibraries": false,
  "task.allowAutomaticTasks": "on",
  "editor.codeActionsOnSave": {},
  "dart.mcpServer": true,
  "chat.mcp.discovery.enabled": {
    "claude-desktop": true
  },
  "editor.largeFileOptimizations": false,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "editor.multiCursorModifier": "ctrlCmd",
  "chat.tools.terminal.outputLocation": "chat",
  "claudeCode.preferredLocation": "panel",
  "workbench.colorTheme": "Catppuccin Macchiato",
  "docker.extension.enableComposeLanguageServer": false,
  "diffEditor.renderSideBySide": false,
  "mermaidChart.showGenerateDiagramCodeLens": false,
}